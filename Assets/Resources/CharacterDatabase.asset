  characterDataList:
  - characterType: 0
    characterPrefab: {fileID: 8033354765224126232, guid: 2518ea32d9ead6d4ca1007a3b1a168bd, type: 3}
    portraitIcon: {fileID: 21300000, guid: 5b8cdfebabb5fa240a8e2074b4deb06e, type: 3}
    illustration: {fileID: 21300000, guid: 5b8cdfebabb5fa240a8e2074b4deb06e, type: 3}
    skillIcon: {fileID: 21300000, guid: 55d6768b974107549a7ca4fc6d43c2d3, type: 3}
    skillPreviewVideo: {fileID: 32900000, guid: 0b16d2b99e87d5c43bd6cf89f20afd29, type: 3}
    backgroundStory: "\uC0DD\uC874\uC790\uB4E4\uC774 \uB208\uC744 \uB72C \n'\uC9C0\uD558
      \uC220\uC9D1'\uC758 \uB9C8\uC2A4\uD130.\n\uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC704\uB85C\uB97C
      \uAC74\uB124\uB358 \uADF8\uB294 \uC7AC\uC559 \uC774\uD6C4 \uD22C\uC7C1\uC744
      \uC120\uD0DD\uD588\uC2B5\uB2C8\uB2E4.\n\uC2AC\uD514\uC744 \uB2EC\uB798\uC8FC\uB358
      \uCE75\uD14C\uC77C \uC250\uC774\uCEE4\uB294 \uC774\uC81C \uB3C5\uD55C \uC220\uACFC
      \uAE30\uC774\uD55C \uC7AC\uB8CC\uB97C \uC11E\uC5B4 \uCE58\uBA85\uC801\uC778
      \uC0C1\uD0DC \uC774\uC0C1\uC744 \uD37C\uBD93\uB294 \uBB34\uAE30\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC9C0\uB9C9
      \uC548\uC2DD\uCC98\uAC00 \uB41C \uC774\uACF3\uC744 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C\uB0BC
      \uC0DD\uAC01\uC785\uB2C8\uB2E4."
    skillDescription: "\uC801\uB4E4\uC744 \uAF3C\uC9DD \uBABB \uD558\uAC8C \uB9CC\uB4E4
      \uD2B9\uC81C \uCE75\uD14C\uC77C \uC138\uD2B8\uB97C \uC900\uBE44\uD569\uB2C8\uB2E4.\n\uCE75\uD14C\uC77C\uC774
      \uBA85\uC911\uD560 \uB54C\uB9C8\uB2E4 \uC608\uCE21\uD560 \uC218 \uC5C6\uB294
      \uB2E4\uCC44\uB85C\uC6B4 \uC0C1\uD0DC \uC774\uC0C1\uC744 \uBD80\uC5EC\uD558\uC5EC
      \uC804\uC7A5\uC758 \uD750\uB984\uC744 \uB4A4\uD754\uB4ED\uB2C8\uB2E4."
  - characterType: 1
    characterPrefab: {fileID: 5991675828630517409, guid: 586719ff637244645be795af1e845ac4, type: 3}
    portraitIcon: {fileID: 21300000, guid: 9381cf51695a21b45ae254a341c20c8d, type: 3}
    illustration: {fileID: 21300000, guid: 9381cf51695a21b45ae254a341c20c8d, type: 3}
    skillIcon: {fileID: 21300000, guid: 58e2ce628477b3d46b57b39240e34488, type: 3}
    skillPreviewVideo: {fileID: 32900000, guid: fcdc9d129fbb4414c983d8939a68ea41, type: 3}
    backgroundStory: "\uD55C\uB54C \uC655\uAD6D\uAD70\uC758 \uBB34\uAE30\uB97C \uB3C4\uB9E1\uC558\uB358
      \uCC9C\uC7AC \uC7A5\uC778.\n\uC804\uC7C1\uC744 \uD53C\uD574 \uC740\uB454\uD588\uC73C\uB098,
      \uC7AC\uC559\uC774 \uB2E5\uCE58\uC790 \uC801\uB4E4\uC758 '\uC601\uD63C\uC758
      \uD30C\uD3B8'\uC744 \uAC70\uB450\uC5B4 \uB2E4\uC2DC \uB9DD\uCE58\uB97C \uC950\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC6D0\uCE58
      \uC54A\uB294 \uACB0\uACFC\uBB3C\uC740 \uAC00\uCC28 \uC5C6\uC774 \uBD80\uC218\uACE0
      \uC0C8\uB85C \uBCBC\uB824\uB0B4\uB294 '\uD30C\uAD34\uC801\uC778 \uC81C\uB828\uBC95'\uC73C\uB85C
      \uB04A\uC784\uC5C6\uC774 \uD55C\uACC4\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4.\n\uC231\uD558\uAC8C
      \uC313\uC778 \uBB34\uAE30\uC758 \uC794\uD574\uB294 \uC644\uBCBD\uC744 \uCD94\uAD6C\uD558\uB294
      \uADF8\uB140\uC758 \uAEBE\uC774\uC9C0 \uC54A\uB294 \uACB0\uC758\uB97C \uC99D\uBA85\uD569\uB2C8\uB2E4."
    skillDescription: "\uC601\uD63C\uC758 \uD30C\uD3B8\uC744 \uD1B5\uD574 \uBB34\uAE30\uB97C
      \uC8FC\uC870\uD558\uACE0 \uC81C\uB828\uD558\uC5EC \uB04A\uC784\uC5C6\uC774
      \uD55C\uACC4\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4.\n\uAC15\uD654\uC5D0 \uC131\uACF5\uD558\uBA74
      \uAC15\uB825\uD55C \uC704\uB825\uC744 \uC5BB\uAC8C \uB418\uC9C0\uB9CC, \uBB34\uB9AC\uD55C
      \uC81C\uB828\uC740 \uACF5\uB4E4\uC778 \uBB34\uAE30\uB97C \uC0B0\uC0B0\uC870\uAC01
      \uB0BC \uC218\uB3C4 \uC788\uC73C\uB2C8 \uC8FC\uC758\uD574\uC57C \uD569\uB2C8\uB2E4.
      \n\uC6D0\uCE58 \uC54A\uB294 \uBB34\uAE30\uB294 \uD30C\uAD34\uD558\uC5EC \uB2E4\uC2DC
      \uBCBC\uB824\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
